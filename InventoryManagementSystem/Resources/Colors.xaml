<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <Color x:Key="AppBackground">#F4F8FC</Color>
    <Color x:Key="SidebarBackground">#EAF2FA</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <!-- Blue Colors -->
    <Color x:Key="PrimaryBlue">#789FC5</Color>
    <Color x:Key="LightBlue">#DCEBFA</Color>
    <Color x:Key="SoftBlue">#B8D4EF</Color>
    <Color x:Key="DarkBlue">#385A7A</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryText">#263B50</Color>
    <Color x:Key="SecondaryText">#8293A5</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#E4EBF2</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>

    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}"/>
    <SolidColorBrush x:Key="LightBlueBrush" Color="{StaticResource LightBlue}"/>
    <SolidColorBrush x:Key="DarkBlueBrush" Color="{StaticResource DarkBlue}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

</ResourceDictionary>
