<UserControl x:Class="InventoryManagementSystem.Views.StockMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F5F9">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E9EDF3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#4169E1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="INVENTORY / OPERATIONS"
                               Foreground="#4169E1"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock Text="Stock Movements"
                               Foreground="#19283F"
                               FontSize="29"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Monitor incoming and outgoing inventory transactions."
                               Foreground="#8995A8"
                               FontSize="12"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="+ Stock In"
                            Style="{StaticResource ActionButton}"
                            Background="#15966B"
                            Margin="0,0,10,0"
                            Click="StockInButton_Click"/>

                    <Button Content="− Stock Out"
                            Style="{StaticResource ActionButton}"
                            Background="#D96A55"
                            Click="StockOutButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- STATISTICS -->
            <UniformGrid Grid.Row="1"
                         Columns="3"
                         Margin="0,0,0,22">

                <Border Style="{StaticResource Card}"
                        Margin="0,0,13,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL MOVEMENTS"
                                   Foreground="#8995A8"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TotalMovementsText"
                                   Text="0"
                                   Foreground="#19283F"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,12,0,5"/>
                        <TextBlock Text="Recorded transactions"
                                   Foreground="#8995A8"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Margin="0,0,13,0">
                    <StackPanel>
                        <TextBlock Text="STOCK IN"
                                   Foreground="#8995A8"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="StockInText"
                                   Text="0"
                                   Foreground="#15966B"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,12,0,5"/>
                        <TextBlock Text="Incoming units"
                                   Foreground="#8995A8"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STOCK OUT"
                                   Foreground="#8995A8"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="StockOutText"
                                   Text="0"
                                   Foreground="#D96A55"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,12,0,5"/>
                        <TextBlock Text="Outgoing units"
                                   Foreground="#8995A8"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- FILTERS -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SEARCH PRODUCT"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#778398"
                                   Margin="0,0,0,9"/>

                        <TextBox x:Name="SearchBox"
                                 Height="40"
                                 Padding="12,8"
                                 FontSize="12"
                                 BorderBrush="#E1E6EF"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MOVEMENT TYPE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#778398"
                                   Margin="0,0,0,9"/>

                        <ComboBox x:Name="MovementFilter"
                                  Height="40"
                                  Padding="9"
                                  FontSize="12"
                                  SelectedIndex="0"
                                  SelectionChanged="MovementFilter_SelectionChanged">
                            <ComboBoxItem Content="All Movements"/>
                            <ComboBoxItem Content="Stock In"/>
                            <ComboBoxItem Content="Stock Out"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HISTORY -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Movement History"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#19283F"/>

                    <TextBlock Text="A complete record of inventory transactions"
                               FontSize="11"
                               Foreground="#8995A8"
                               Margin="0,5,0,18"/>

                    <DataGrid x:Name="MovementsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeight="55"
                              MinWidth="850"
                              Background="White"
                              BorderThickness="0"
                              FontSize="12"
                              ColumnWidth="*">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding MovementId}"
                                                Width="70"/>

                            <DataGridTextColumn Header="PRODUCT"
                                                Binding="{Binding ProductName}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="TYPE"
                                                Binding="{Binding MovementType}"
                                                Width="*"/>

                            <DataGridTextColumn Header="QUANTITY"
                                                Binding="{Binding Quantity}"
                                                Width="*"/>

                            <DataGridTextColumn Header="DATE"
                                                Binding="{Binding MovementDate, StringFormat={}{0:dd MMM yyyy HH:mm}}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="NOTE"
                                                Binding="{Binding Note}"
                                                Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
