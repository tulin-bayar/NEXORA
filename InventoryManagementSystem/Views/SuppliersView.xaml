<UserControl x:Class="InventoryManagementSystem.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F5F9">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E8ECF2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#263D5B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DCE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- HEADER -->
            <Grid Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Supplier Management"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#17283F"/>

                    <TextBlock Text="Manage your suppliers and business contacts"
                               FontSize="13"
                               Foreground="#8792A2"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Button Content="+ Add Supplier"
                        Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="AddSupplierButton_Click"/>
            </Grid>

            <!-- STATISTICS -->
            <UniformGrid Columns="3" Margin="0,0,0,22">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL SUPPLIERS"
                                   Foreground="#8792A2"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalSuppliersText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#17283F"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Registered suppliers"
                                   Foreground="#98A2B1"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE SUPPLIERS"
                                   Foreground="#8792A2"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActiveSuppliersText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#239B72"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Currently active"
                                   Foreground="#98A2B1"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="INACTIVE SUPPLIERS"
                                   Foreground="#8792A2"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="InactiveSuppliersText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#D18B36"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Currently inactive"
                                   Foreground="#98A2B1"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- SUPPLIER FORM -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock x:Name="FormTitleText"
                               Text="Supplier Information"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#17283F"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                            <TextBlock Text="Company Name"
                                       FontWeight="SemiBold"
                                       Foreground="#536176"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="CompanyNameBox"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Enter company name"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,14">
                            <TextBlock Text="Contact Person"
                                       FontWeight="SemiBold"
                                       Foreground="#536176"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="ContactPersonBox"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Enter contact person"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                            <TextBlock Text="Phone Number"
                                       FontWeight="SemiBold"
                                       Foreground="#536176"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="PhoneBox"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Enter phone number"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,14">
                            <TextBlock Text="Email Address"
                                       FontWeight="SemiBold"
                                       Foreground="#536176"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="EmailBox"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Enter email address"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Address"
                                       FontWeight="SemiBold"
                                       Foreground="#536176"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="AddressBox"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Enter address"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Status"
                                       FontWeight="SemiBold"
                                       Foreground="#536176"
                                       Margin="0,0,0,7"/>
                            <ComboBox x:Name="StatusBox"
                                      Height="38"
                                      SelectedIndex="0"
                                      Padding="8">
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Inactive"/>
                            </ComboBox>
                        </StackPanel>

                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">

                        <Button x:Name="CancelEditButton"
                                Content="Cancel"
                                Padding="18,10"
                                Background="#EDF0F5"
                                Foreground="#536176"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                Click="CancelEditButton_Click"
                                Visibility="Collapsed"/>

                        <Button x:Name="SaveSupplierButton"
                                Content="Save Supplier"
                                Style="{StaticResource ActionButton}"
                                Click="SaveSupplierButton_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- SUPPLIER LIST -->
            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="All Suppliers"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#17283F"
                               Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,12,0"
                                 ToolTip="Search suppliers"
                                 TextChanged="SearchBox_TextChanged"/>

                        <ComboBox x:Name="StatusFilter"
                                  Grid.Column="1"
                                  Height="38"
                                  Padding="8"
                                  SelectedIndex="0"
                                  SelectionChanged="StatusFilter_SelectionChanged">
                            <ComboBoxItem Content="All Suppliers"/>
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>
                    </Grid>

                    <DataGrid x:Name="SuppliersDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeight="52"
                              ColumnHeaderHeight="42"
                              Background="White"
                              BorderThickness="0"
                              SelectionMode="Single"
                              AlternatingRowBackground="#F8FAFC">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding SupplierId}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Company"
                                                Binding="{Binding CompanyName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Contact Person"
                                                Binding="{Binding ContactPerson}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Phone"
                                                Binding="{Binding Phone}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="100"/>

                            <DataGridTemplateColumn Header="Actions"
                                                    Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <Button Content="Edit"
                                                    Padding="9,5"
                                                    Margin="0,0,6,0"
                                                    Background="#EAF0F8"
                                                    Foreground="#263D5B"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="EditSupplierButton_Click"/>

                                            <Button Content="Delete"
                                                    Padding="9,5"
                                                    Background="#FCEEEE"
                                                    Foreground="#C34D4D"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="DeleteSupplierButton_Click"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
