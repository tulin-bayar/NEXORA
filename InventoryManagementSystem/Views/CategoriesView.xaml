 <UserControl x:Class="InventoryManagementSystem.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DarkText" Color="#24364B"/>
        <SolidColorBrush x:Key="MutedText" Color="#8793A3"/>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DCE3EB"/>
            <Setter Property="Background" Value="#FAFBFD"/>
            <Setter Property="Foreground" Value="#24364B"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <TextBlock Text="Category Management"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource DarkText}"/>

            <TextBlock Text="Organize and manage your inventory categories."
                       FontSize="13"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,7,0,22"/>

            <!-- STATISTICS -->
            <UniformGrid Columns="2" Margin="0,0,0,22">

                <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL CATEGORIES"
                                   FontSize="11"
                                   Foreground="#8793A3"/>
                        <TextBlock x:Name="TotalCategoriesText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#24364B"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL PRODUCTS"
                                   FontSize="11"
                                   Foreground="#8793A3"/>
                        <TextBlock x:Name="TotalProductsText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#315B86"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- CATEGORY FORM -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,22">

                <StackPanel>

                    <TextBlock x:Name="FormTitleText"
                               Text="Add New Category"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#24364B"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="Category Name"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#536477"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="NewCategoryBox"
                             Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="Description"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#536477"
                               Margin="0,15,0,7"/>

                    <TextBox x:Name="DescriptionBox"
                             Style="{StaticResource InputStyle}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">

                        <Button x:Name="CancelEditButton"
                                Content="Cancel"
                                Click="CancelEditButton_Click"
                                Padding="18,10"
                                Background="#EDF2F7"
                                Foreground="#536477"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                Cursor="Hand"/>

                        <Button x:Name="SaveCategoryButton"
                                Content="Save Category"
                                Click="SaveCategoryButton_Click"
                                Padding="18,10"
                                Background="#315B86"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- CATEGORY LIST -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel>

                    <TextBlock Text="All Categories"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#24364B"
                               Margin="0,0,0,15"/>

                    <TextBox x:Name="SearchBox"
                             Height="38"
                             Padding="10"
                             FontSize="13"
                             BorderBrush="#DCE3EB"
                             Background="#FAFBFD"
                             TextChanged="SearchBox_TextChanged"
                             Margin="0,0,0,15"/>

                    <DataGrid x:Name="CategoriesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeight="48"
                              MinHeight="250"
                              Background="White">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding CategoryId}"
                                                Width="65"/>

                            <DataGridTextColumn Header="Category Name"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Products"
                                                Binding="{Binding ProductCount}"
                                                Width="100"/>

                            <DataGridTemplateColumn Header="Actions"
                                                    Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">

                                            <Button Content="Edit"
                                                    Click="EditCategoryButton_Click"
                                                    Tag="{Binding}"
                                                    Padding="10,5"
                                                    Margin="2"
                                                    Background="#EDF2F7"
                                                    Foreground="#315B86"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>

                                            <Button Content="Delete"
                                                    Click="DeleteCategoryButton_Click"
                                                    Tag="{Binding}"
                                                    Padding="10,5"
                                                    Margin="2"
                                                    Background="#FCEEEE"
                                                    Foreground="#C34D4D"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
